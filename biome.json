{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/node_modules",
      "!!**/test-results",
      "!!**/playwright-report",
      "!package-lock.json",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "recommended",
      "next": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/universe/universe-bodies.tsx"],
      "linter": {
        "rules": {
          "a11y": { "noStaticElementInteractions": "off" }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [
                "react",
                "react/**",
                "react-dom",
                "react-dom/**",
                "next",
                "next/**",
                "next-intl",
                "next-intl/**"
              ],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/**",
              ":BLANK_LINE:",
              ":PATH:"
            ],
            "sortBareImports": false,
            "identifierOrder": "natural"
          }
        }
      }
    }
  }
}
